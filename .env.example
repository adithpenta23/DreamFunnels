# =============================================================================
# DreamFunnels environment variables
#
# Local development:  cp .env.example .env.local   (then fill in the values)
# Vercel:             Project Settings -> Environment Variables, per environment
#
# Three environments, each with its OWN Supabase project and keys:
#
#   | Variable                        | local            | staging | production |
#   | ------------------------------- | ---------------- | ------- | ---------- |
#   | APP_ENV                         | local (default)  | staging | production |
#   | NEXT_PUBLIC_APP_URL             | http://localhost | https   | https      |
#   | NEXT_PUBLIC_SUPABASE_URL        | local stack      | https   | https      |
#   | SUPABASE_SECRET_KEY             | optional         | required| required   |
#   | NEXT_PUBLIC_TURNSTILE_SITE_KEY  | optional         | required| required*  |
#   | TURNSTILE_SECRET_KEY            | optional         | required| required*  |
#   | EMAIL_PROVIDER                  | mailpit (default)| resend  | resend     |
#   | EMAIL_FROM_ADDRESS              | optional         | required| required** |
#   | RESEND_API_KEY                  | optional         | required| required   |
#
#   * Cloudflare's test keys (1x000…) are rejected in production.
#   ** Resend's shared test sender (@resend.dev) is rejected in production.
#   Staging/production builds fail with a list of anything missing or unsafe
#   (src/lib/env/schema.ts#parseDeploymentEnv). See docs/ARCHITECTURE.md
#   "Environments".
#
# - Never commit real values. .env* files are git-ignored except this one.
# - NEXT_PUBLIC_* values are inlined into the browser bundle: never put secrets in them.
# - Validated at build/startup by src/lib/env/schema.ts; the app refuses to
#   start with a clear error if a required value is missing or malformed.
# - Leave optional values empty to disable the integration.
# =============================================================================

# --- App (required) ----------------------------------------------------------
# Which environment this is: local | staging | production. Leave empty locally
# (defaults to local). Vercel deployments must set staging or production.
APP_ENV=

# Public base URL of this deployment. Used for auth email links and metadata.
# Set per environment (production, staging, local).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (required) -----------------------------------------------------
# Project URL. Local stack (`npm run db:start`): http://127.0.0.1:54321
# Hosted: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable key (sb_publishable_...) or the legacy "anon" key.
# Browser-safe: all access through it is constrained by Row Level Security.
# Local stack: printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-publishable-key

# --- Supabase (server-only; required in staging and production) ---------------
# Secret key (sb_secret_...) or the legacy "service_role" key.
# BYPASSES ROW LEVEL SECURITY. Only for trusted server code with no user in
# the loop (webhooks, jobs, the auth rate limiter's counters).
# Never prefix with NEXT_PUBLIC_, never log it, never expose it to the browser.
# Without it (local only) rate-limit counters live in process memory.
# The E2E suite also uses it (local stack only) to read password-reset links,
# provision client workspaces and delete its test users.
# Local stack: printed by `npx supabase status`.
SUPABASE_SECRET_KEY=

# --- CAPTCHA: Cloudflare Turnstile (required in staging and production) -------
# Protects sign-up and password reset. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile with this environment's
# hostname. Set both or neither; leave both empty locally to disable the CAPTCHA
# (tests never call Cloudflare). The site key is public; the secret is not.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Transactional email (required in staging and production) -----------------
# Invitations today; confirmations, reminders and review requests later.
# Which provider sends: `mailpit` (the default when empty) delivers to the local
# stack's mail catcher at http://127.0.0.1:54324 and nowhere else; `resend`
# sends for real and is required when APP_ENV is staging or production.
EMAIL_PROVIDER=
# Sender address, on a domain verified in Resend (e.g. no-reply@mail.example.com).
# Required with resend. Production rejects Resend's @resend.dev test sender.
EMAIL_FROM_ADDRESS=
# Sender display name. Defaults to "DreamFunnels".
EMAIL_FROM_NAME=
# Resend API key (re_…), created with "Sending access" only. Server-only secret.
RESEND_API_KEY=
# Mailpit's address, if not the local stack's default (also read by the E2E suite).
MAILPIT_URL=

# --- Logging (optional) -------------------------------------------------------
# One of: debug | info | warn | error | silent
# Defaults: debug in development, info in production, silent in tests.
LOG_LEVEL=

# --- Error monitoring: Sentry (optional, not yet wired) -----------------------
# DSN is public by design. The auth token is a build-time secret used only
# to upload source maps; keep it in CI/Vercel secrets, not in .env.local.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Product analytics: PostHog (optional, not yet wired) ---------------------
# Project API key (public by design) and ingestion host.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Testing (read by Playwright only, never by the app) -----------------------
# Set to 1 to make e2e/auth.spec.ts fail, instead of skip, when Supabase isn't
# reachable. CI sets it; leave it empty locally.
E2E_REQUIRE_SUPABASE=
