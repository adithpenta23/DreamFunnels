{
  "name": "dreamfunnels",
  "version": "0.1.0",
  "private": true,
  "description": "DreamFunnels — AI-native funnel and website builder",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit --project components",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:confirmation": "playwright test --project=confirmation",
    "test:staging": "playwright test --config=playwright.staging.config.ts",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:migration:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public > src/types/database.types.ts && prettier --write src/types/database.types.ts",
    "db:types:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/check-db-types.mts",
    "verify:hosted": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/verify-hosted.mts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "0.3.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
