# dependencies
/node_modules
/.pnp
.pnp.*

# testing
/coverage
/playwright-report
/test-results
/playwright-report-staging
/test-results-staging
/blob-report
/playwright/.cache

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# env files: never commit real values; the example is the contract
.env*
!.env.example

# supabase cli state
# ...except rest-version, which pins the local PostgREST image (see docs/QA.md). `supabase link`
# overwrites it with the linked project's version, which is what local parity wants.
/supabase/.temp/*
!/supabase/.temp/rest-version
/supabase/.branches

# vercel
.vercel

# misc
.DS_Store
*.pem
npm-debug.log*
.claude/settings.local.json
